# Variáveis de ambiente da aplicação Java (Spring Boot).
#
# Copie este arquivo para `.env` e ajuste os valores se precisar.
# O `.env` é carregado automaticamente pelo spring-dotenv quando a aplicação roda
# fora do Docker (ex.: `mvn spring-boot:run` ou pela IDE), apontando para os serviços
# expostos pelo `docker-compose.yml` (postgres/rabbitmq/kafka) nas portas do host.
#
# Nunca commite o `.env` real — apenas este `.env.example` (sem segredos de produção).
# Variáveis de ambiente reais sempre têm prioridade sobre o `.env` (seguro em produção).

# ─── PostgreSQL ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=java
DB_USERNAME=java
DB_PASSWORD=java

# ─── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=java
RABBITMQ_PASSWORD=java

# ─── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── JWT ───────────────────────────────────────────────────────────────────
# Gere um segredo forte para ambientes reais, por exemplo: openssl rand -base64 64
JWT_SECRET=minha-chave-secreta-de-pelo-menos-256-bits-para-hs256-segura
JWT_EXPIRATION_MS=86400000

# ─── Upload de arquivos ────────────────────────────────────────────────────
UPLOAD_DIRECTORY=.docker/uploads
UPLOAD_MAX_SIZE_BYTES=10485760
